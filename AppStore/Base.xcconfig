PRODUCT_NAME = One Clipboard History
EXECUTABLE_NAME = OneClipboardHistory
PRODUCT_MODULE_NAME = OneClipboardHistoryApp
PRODUCT_BUNDLE_IDENTIFIER = com.armateurlabs.oneclipboardhistory
MARKETING_VERSION = 0.7.0
CURRENT_PROJECT_VERSION = 7
MACOSX_DEPLOYMENT_TARGET = 27.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = AppStore/OneClipboardHistory.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = AppStore/Info.plist
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
COMBINE_HIDPI_IMAGES = YES
SKIP_INSTALL = NO
INSTALL_PATH = $(LOCAL_APPS_DIR)
